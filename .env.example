# Atlas — variables d'environnement (compile-time via dart-define-from-file)
#
# 1. Copier le fichier correspondant à votre environnement :
#    cp .env.development.example .env.development
# 2. Remplir SUPABASE_URL et SUPABASE_ANON_KEY (clé anon publique uniquement).
# 3. Lancer l'app :
#    flutter run --dart-define-from-file=.env.development
#
# Ne jamais committer les fichiers .env.* réels.
# Ne jamais placer la clé service-role Supabase dans l'application Flutter.
#
# TestFlight / release :
#   Utiliser .env.staging ou .env.production avec de VRAIES valeurs.
#   Les builds release / ATLAS_ENV=staging|production refusent les placeholders.
#   Prochain numéro de build attendu : 1.0.0+3 (changer `version:` dans pubspec.yaml).

ATLAS_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: show Apple/Google on the auth sheet (default false for Marrakech beta).
SHOW_SOCIAL_AUTH=false
# Optional: Assistant + Itinéraires entry points (default false for Marrakech beta).
SHOW_EXPERIMENTAL_SURFACES=false
# Optional: in-app Signaler FAB (default true for private beta / TestFlight).
SHOW_BETA_FEEDBACK=true
# Optional crash reporting (private beta). Leave empty to disable.
SENTRY_DSN=
